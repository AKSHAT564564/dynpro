# ============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Context-Aware Question Generator"

# FastAPI Settings
API_PORT=8000
API_HOST=0.0.0.0

# Storage Settings
OUTPUT_DIR=./output

# MCP Configuration
MCP_CONFIG_PATH=mcp.json

# ============================================================================
# LLM Provider Credentials
# ============================================================================

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT
OPENAI_API_KEY=sk-...

# ============================================================================
# MCP Credentials - Confluence
# ============================================================================
CONFLUENCE_API_URL=https://company.confluence.com
CONFLUENCE_API_KEY=your-confluence-api-key

# ============================================================================
# MCP Credentials - Jira
# ============================================================================
JIRA_API_URL=https://company.atlassian.net
JIRA_API_KEY=your-jira-api-key

# ============================================================================
# MCP Credentials - Salesforce CRM
# ============================================================================
SALESFORCE_INSTANCE_URL=https://company.salesforce.com
SALESFORCE_CLIENT_ID=your-client-id
SALESFORCE_CLIENT_SECRET=your-client-secret
SALESFORCE_USERNAME=your-salesforce-username
SALESFORCE_SECURITY_TOKEN=your-security-token

# ============================================================================
# MCP Credentials - HubSpot
# ============================================================================
HUBSPOT_API_KEY=your-hubspot-api-key

# ============================================================================
# MCP Credentials - GitHub (Optional)
# ============================================================================
GITHUB_TOKEN=your-github-token
GITHUB_ORG=your-org-name

# ============================================================================
# MCP Credentials - Custom Systems (Optional)
# ============================================================================
ERP_API_URL=https://erp.company.com/api
ERP_API_KEY=your-erp-api-key

WIKI_GRAPHQL_URL=https://wiki.company.com/graphql
WIKI_API_KEY=your-wiki-api-key
